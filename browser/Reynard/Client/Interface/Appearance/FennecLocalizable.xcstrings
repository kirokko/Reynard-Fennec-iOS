{
  "sourceLanguage": "en",
  "strings": {
    "Private tabs locked": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "隐私分页已锁定" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "隱私分頁已鎖定" } } } },
    "Unlock your private tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "请验证身份以重新浏览隐私分页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "請驗證身分以重新瀏覽隱私分頁" } } } },
    "Unlock private tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "解锁隐私分页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "解鎖隱私分頁" } } } },
    "Return to normal browsing": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "返回普通浏览" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "返回一般瀏覽" } } } },
    "Private tabs remain locked. Try again or return to normal browsing.": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "隐私分页仍处于锁定状态。请重试或返回普通浏览。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "隱私分頁仍處於鎖定狀態。請重試或返回一般瀏覽。" } } } },
    "Capture protection experiment": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "防截录诊断（实验）" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "防截錄診斷（實驗）" } } } },
    "Tap to test interaction": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "点击测试交互" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "點擊測試互動" } } } },
    "Not verified on this device": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "此设备尚未验证防截录成功" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "此裝置尚未驗證防截錄成功" } } } },
    "Synthetic test only. 0: normal; 1: secure canvas; 2: experimental layer flag. Keep using the red area, take a screenshot and record the screen. Protection is demonstrated only if the red area stays visible on the phone but disappears from the captures. This does not protect browser tabs.": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "仅为合成测试。0：普通；1：安全画布；2：实验图层标志。请操作红色区域，同时截图和录屏。只有手机上红色区域仍正常显示、而截图和录像中消失，才说明该测试有效。本测试不保护浏览器标签页。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "僅為合成測試。0：一般；1：安全畫布；2：實驗圖層旗標。請操作紅色區域，同時截圖及錄影。只有手機上紅色區域仍正常顯示、而截圖和錄影中消失，才表示此測試有效。本測試不保護瀏覽器分頁。" } } } },
    "Who can see my browsing history?": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "谁可以看到我的上网记录？" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "誰可能看到我的上網紀錄？" } } } },
    "This time search in": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "此次搜索使用" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "此次搜尋使用" } } } },
    "Normal tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "返回普通标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "返回一般分頁" } } } },
    "Search engines": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "搜索引擎" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "搜尋引擎" } } } },
    "Search settings": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "搜索设置" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "搜尋設定" } } } },
    "Private content hidden": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "隐私内容已遮挡" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "隱私內容已遮蔽" } } } },
    "Rotate video": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "旋转视频" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "旋轉影片" } } } },
    "Return to portrait": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "恢复竖屏" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "恢復直向" } } } },
    "Landscape follows device": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "横屏方向跟随设备" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "橫向跟隨裝置" } } } },
    "Portrait": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "竖屏" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "直向" } } } },
    "Unable to rotate video": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "系统未允许旋转视频" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "系統未允許旋轉影片" } } } },
    "Sort by custom order": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "按自定义顺序排列" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "依自訂順序排列" } } } },
    "Sort by newest": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "按最新排列" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "依最新排列" } } } },
    "Sort by oldest": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "按最早排列" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "依最舊排列" } } } },
    "Sort by A to Z": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "按 A 到 Z 排列" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "依 A 到 Z 排列" } } } },
    "Sort by Z to A": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "按 Z 到 A 排列" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "依 Z 到 A 排列" } } } },
    "All": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "全部" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "全部" } } } },
    "Images": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "图片" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "圖片" } } } },
    "Other": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "其他" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "其他" } } } },
    "Leave no traces on this device": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "不在此设备上留下痕迹" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "不在此裝置上留下痕跡" } } } },
    "Private browsing": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "隐私浏览" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "隱私瀏覽" } } } },
    "Private tabs stay separate from your regular tabs. Close them to clear their browsing history and cookies.": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "隐私标签页与普通标签页相互独立。关闭隐私标签页即可清除其中的浏览记录和 Cookie。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "隱私分頁與一般分頁相互獨立。關閉隱私分頁即可清除其中的瀏覽紀錄與 Cookie。" } } } },
    "Recently closed tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "最近关闭的标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "最近關閉的分頁" } } } },
    "Tab settings": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "标签页设置" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "分頁設定" } } } },
    "Close all tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "关闭所有标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "關閉所有分頁" } } } },
    "Continue": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "继续浏览" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "繼續瀏覽" } } } },
    "Tracking protection": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "跟踪保护" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "追蹤保護" } } } },
    "%d blocked trackers in open tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前普通标签页中已拦截 %d 个跟踪器" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前一般分頁中已封鎖 %d 個追蹤器" } } } },
    "Tab groups": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "标签组" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "分頁群組" } } } },
    "Select open tabs to create a group. Groups are stored only on this device.": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择已打开的标签页以创建分组。分组仅保存在本机。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "選取已開啟的分頁以建立群組。群組僅儲存於此裝置。" } } } },
    "%d open tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%d 个打开的标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "%d 個開啟的分頁" } } } },
    "Ungroup": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "解散分组" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "解散群組" } } } },
    "Search tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "搜索标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "搜尋分頁" } } } },
    "Edit group": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "编辑分组" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "編輯群組" } } } },
    "Remove from group": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "移出分组" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "移出群組" } } } },
    "New group": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "新建分组" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "新增群組" } } } },
    "Group name": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "分组名称" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "群組名稱" } } } },
    "Select tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "選取分頁" } } } },
    "Close manually": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "手动关闭" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "手動關閉" } } } },
    "ieynec clears private browsing history and cookies when you close private tabs. Downloads and bookmarks are kept.": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "关闭隐私标签页后，ieynec 会清除其中的浏览记录和 Cookie。下载文件和书签仍会保留。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "關閉隱私分頁後，ieynec 會清除其中的瀏覽紀錄與 Cookie。下載檔案和書籤仍會保留。" } } } },
    "New tab": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "新建标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "新增分頁" } } } },
    "New private tab": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "新建隐私标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "新增隱私分頁" } } } },
    "Menu": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "菜单" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "選單" } } } },
    "Tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "分頁" } } } },
    "Private": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "隐私" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "隱私" } } } },
