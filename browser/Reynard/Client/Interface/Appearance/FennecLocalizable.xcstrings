{
  "sourceLanguage": "en",
  "strings": {
    "Continue": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "继续浏览" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "繼續瀏覽" } } } },
    "Tracking protection": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "跟踪保护" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "追蹤保護" } } } },
    "%d blocked trackers in open tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前普通标签页中已拦截 %d 个跟踪器" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前一般分頁中已封鎖 %d 個追蹤器" } } } },
    "Tab groups": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "标签组" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "分頁群組" } } } },
    "Select open tabs to create a group. Groups are stored only on this device.": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择已打开的标签页以创建分组。分组仅保存在本机。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "選取已開啟的分頁以建立群組。群組僅儲存於此裝置。" } } } },
    "%d open tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%d 个打开的标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "%d 個開啟的分頁" } } } },
    "Ungroup": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "解散分组" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "解散群組" } } } },
    "Search tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "搜索标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "搜尋分頁" } } } },
    "Edit group": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "编辑分组" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "編輯群組" } } } },
    "Remove from group": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "移出分组" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "移出群組" } } } },
    "New group": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "新建分组" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "新增群組" } } } },
    "Group name": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "分组名称" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "群組名稱" } } } },
    "Select tabs": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择标签页" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "選取分頁" } } } },
    "Close manually": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "手动关闭" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "手動關閉" } } } },
    "ieynec clears private browsing history and cookies when you close private tabs. Downloads and bookmarks are kept.": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "关闭隐私标签页后，ieynec 会清除其中的浏览记录和 Cookie。下载文件和书签仍会保留。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "關閉隱私分頁後，ieynec 會清除其中的瀏覽紀錄與 Cookie。下載檔案和書籤仍會保留。" } } } },
